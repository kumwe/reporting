{
  "name": "kumwe/reporting",
  "description": "Bounded report and projection definitions with neutral projection contracts.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/reporting",
  "require": {
    "php": "^8.5",
    "php-64bit": "*",
    "ext-json": "*",
    "kumwe/business-definition": "0.1.0",
    "kumwe/contribution": "0.1.0",
    "kumwe/integration": "0.1.0",
    "kumwe/access-context": "0.1.0",
    "kumwe/conversion": "0.1.2",
    "kumwe/access-control": "0.1.0",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0 || ^13.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Reporting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Reporting\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php tools/lint.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "manifests": "php tools/manifests.php",
    "check": [
      "composer validate --strict",
      "@lint",
      "@architecture",
      "@test",
      "@analyse",
      "@cs",
      "@manifests",
      "@governance",
      "@security:audit",
      "@release:check",
      "@clean-consumer"
    ],
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "security:audit": "composer audit --abandoned=fail",
    "architecture": "php tools/architecture.php",
    "release:check": [
      "bash tools/test-release-record.sh",
      "bash tools/test-release-integrity.sh",
      "bash tools/test-release-on-record.sh",
      "bash tools/test-configure-release-repositories.sh",
      "bash tools/test-release-dependencies.sh",
      "bash tools/test-package-dependencies.sh"
    ],
    "governance": "php tools/verify-governance.php"
  },
  "config": {
    "sort-packages": true,
    "github-protocols": [
      "https"
    ]
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/tests",
      "/tools",
      "/.github",
      "/composer.local.json",
      "/composer.local.lock",
      "/composer.lock",
      "/phpstan.neon",
      "/phpcs.xml",
      "/phpunit.xml",
      "/.phpstan-cache",
      "/.phpunit.cache",
      "/.gitignore",
      "/.gitattributes",
      "/composer.candidate.json",
      "/composer.candidate.lock"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/access-control.git"
    }
  ]
}
