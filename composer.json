{
  "name": "kumwe/reporting",
  "description": "Bounded report and projection definitions with neutral projection contracts.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/reporting",
  "require": {
    "php": "^8.5",
    "php-64bit": "*",
    "ext-json": "*",
    "kumwe/business-definition": "0.1.0",
    "kumwe/contribution": "0.1.0",
    "kumwe/integration": "dev-agent/extract-integration-v2",
    "kumwe/access-context": "0.1.0",
    "kumwe/conversion": "0.1.0",
    "kumwe/access-control": "0.1.0",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Reporting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Reporting\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php tools/lint.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "manifests": "php tools/manifests.php",
    "check": [
      "composer validate --strict",
      "@lint",
      "@test",
      "@analyse",
      "@cs",
      "@manifests"
    ],
    "cs": "phpcs -q",
    "cs:fix": "phpcbf"
  },
  "config": {
    "sort-packages": true
  }
}
