{
  "name": "kumwe/reporting",
  "description": "Bounded report and projection definitions with neutral projection contracts.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/reporting",
  "require": {
    "php": "^8.5",
    "php-64bit": "*",
    "ext-json": "*",
    "kumwe/business-definition": "dev-agent/candidate-sequence-dependency-v2",
    "kumwe/contribution": "0.1.0",
    "kumwe/integration": "dev-agent/extract-integration-v2",
    "kumwe/access-context": "0.1.0",
    "kumwe/conversion": "0.1.0",
    "kumwe/access-control": "dev-agent/access-membership-di-completion",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Reporting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Reporting\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php tools/lint.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "manifests": "php tools/manifests.php",
    "check": [
      "composer validate --strict",
      "@lint",
      "@architecture",
      "@test",
      "@analyse",
      "@cs",
      "@manifests"
    ],
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "security:audit": "composer audit --abandoned=fail",
    "architecture": "php tools/architecture.php"
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/tests",
      "/tools",
      "/.github",
      "/composer.local.json",
      "/composer.local.lock",
      "/composer.lock",
      "/phpstan.neon",
      "/phpcs.xml",
      "/phpunit.xml",
      "/.phpstan-cache",
      "/.phpunit.cache",
      "/.gitignore",
      "/.gitattributes",
      "/composer.candidate.json",
      "/composer.candidate.lock"
    ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/business-definition.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/integration.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/automation.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/canonical-json.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/sequence.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/access-control.git"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
